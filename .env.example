# ============================================================
# COLD TRADING PLATFORM — Required Environment Variables
# Copy to .env.local and fill all values before running
# NEVER commit .env.local — it is in .gitignore
# ============================================================

# --- Database (REQUIRED) ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# --- Auth / JWT (REQUIRED, min 32 chars each) ---
JWT_SECRET=minimum-32-character-secret-replace-this-now!!
SESSION_SECRET=minimum-32-character-secret-replace-this-now!!
SECRET=minimum-32-character-secret-replace-this-now!!

# --- Google OAuth (REQUIRED) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- CoinGecko (REQUIRED) ---
COINGECKO_API_KEY=your_coingecko_demo_key
COINGECKO_BASE=https://api.coingecko.com/api/v3

# --- OpenSea (optional) ---
OPENSEA_API_KEY=your_opensea_api_key

# --- CryptoCompare (optional) ---
API_KEY=your_cryptocompare_api_key
CRYPTOCOMPARE=your_cryptocompare_api_key
NEXT_PUBLIC_CRYPTOCOMPARE=your_cryptocompare_api_key

# --- Reddit API (optional) ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_REDIRECT_URI=http://localhost:3000/callback
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
USER_AGENT=CryptoInfoFetcher/1.0 by your_reddit_username

# --- AI (optional) ---
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_key

# --- Monitoring (optional) ---
NEXT_PUBLIC_SENTRY_DSN=

# --- 2FA / TOTP (optional) ---
TOTP_ISSUER_NAME=ColdTrade

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:3000
PORT=3000